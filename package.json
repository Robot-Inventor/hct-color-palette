{
  "name": "smart-chroma",
  "version": "1.0.0",
  "description": "HCT based color palette tool.",
  "homepage": "https://github.com/Robot-Inventor/hct-color-palette#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/hct-color-palette/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/hct-color-palette.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production rspack build",
    "dev": "cross-env NODE_ENV=development rspack build --watch",
    "serve": "cross-env NODE_ENV=development rspack serve --config rspack.serve.config.ts",
    "lint": "oxlint ./src ./rspack.*.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.0.0",
    "html-inline-script-webpack-plugin": "^3.1.0",
    "html-to-image": "^1.11.7",
    "style-loader": "^4.0.0"
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.88.0",
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/ts-utils": "^0.8.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@rspack/dev-server": "^2.0.0",
    "@types/chroma-js": "^3.0.0",
    "@types/node": "^26.6.4",
    "chokidar": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "html-webpack-plugin": "^5.6.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.0"
  }
}
